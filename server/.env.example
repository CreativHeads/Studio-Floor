NODE_ENV=development
PORT=8000
DEBUG=true

# MySQL on Hostinger. Leave DB_HOST empty to use local SQLite (server/data.sqlite).
DB_HOST=
DB_NAME=u123_studioplus
DB_USER=u123_user
DB_PASS=

JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin service account JSON on ONE line (or a file path)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# Cloudinary (required on Hostinger so uploads survive redeploys)
CLOUDINARY_URL=
# or:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: payment return page (same origin is used automatically on Web Apps)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional admin booking-alert email (Brevo / SMTP)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Studio Floor <booking@studiofloor.com>

# Local only: set true to enable /api/auth/dev-login (never in production)
ENABLE_DEV_LOGIN=false
# Seed demo admin + studios on empty DB (auto in dev, off in production unless true)
AUTO_SEED=

# Phone numbers (comma separated, with country code) that become ADMIN after Firebase OTP login
ADMIN_PHONES=
